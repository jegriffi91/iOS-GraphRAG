# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
# Ignore typical Python ``dist/`` build output (sdist + wheels) without
# swallowing the launchd plist + README under ``dist/launchd/`` that
# Phase 4c ships as a distribution asset. The exclusion pattern below
# ignores everything in ``dist/`` EXCEPT ``dist/launchd/``.
dist/*
!dist/launchd/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# SQLite Databases
*.sqlite
*.db

# Logs
*.log
indexer_errors.log

# OS
.DS_Store
Thumbs.db

# Test / Mock Data
mock_repo/
test_fixtures/**/.build/

# Benchmark output (per-machine, per-run; commit specific results manually)
benchmarks/results/*.json

# Work-Machine Specific (Do NOT commit production indexer)
engine/core/indexer_prod.py
engine/core/server_prod.py
